          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { git diff --quiet HEAD -- initial-specs.md docs CLAUDE.md || python3 -m unittest telemetry.spec_sync_test telemetry.invariants_test >&2 || exit 2; }",
