{
  "permissions": {
    "allow": [
      "WebFetch(domain:forecast.weather.gov)",
      "Bash(make health *)",
      "Bash(make aggregate *)",
      "Bash(make check *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=/Users/oz/Documents/git/gundam-ai python3 -m telemetry.hook",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
